{
    "imports": {
        "fn/":       "https://cdn.jsdelivr.net/gh/stephband/fn@1.7.0/modules/"
    },
    "compilerOptions": {
        "strict": true
    },
    "fmt": {
        "useTabs": false,
        "indentWidth": 4,
        "lineWidth": 80,
        "proseWrap": "always",
        "semiColons": true
    },
    "lint": {
        "rules": {
            "tags": ["recommended"]
        }
    },
    "lock": false
}
