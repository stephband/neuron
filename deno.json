{
    "imports": {
        "fn/":       "https://cdn.jsdelivr.net/gh/stephband/fn@1.6.7/modules/",
        "midi/":     "https://cdn.jsdelivr.net/gh/stephband/midi@1.1.x/modules/",
        "sequence/": "https://cdn.jsdelivr.net/gh/soundio/sequence@0.3.14/modules/"
    },
    "compilerOptions": {
        "strict": true
    },
    "fmt": {
        "useTabs": false,
        "indentWidth": 4,
        "lineWidth": 80,
        "proseWrap": "always",
        "semiColons": true
    },
    "lint": {
        "rules": {
            "tags": ["recommended"]
        }
    }
}
